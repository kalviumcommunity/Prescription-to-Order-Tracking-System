# Copy to server/.env and adjust as needed.

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgres://rxuser:rxpass@localhost:5433/rxtracker

# API server
PORT=4000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Seed: first admin account (created by db/seed.js)
SEED_ADMIN_NAME=Root Admin
SEED_ADMIN_EMAIL=admin@rxtracker.local
SEED_ADMIN_PASSWORD=admin12345
