# Copy to server/.env and adjust as needed.
# In Render, set these as Environment Variables in the service dashboard instead
# of committing a file. NODE_ENV, DATABASE_URL and JWT_SECRET are REQUIRED in
# production — the server refuses to start without them (see src/config.js).

# development | production. Render sets this to "production" automatically.
NODE_ENV=development

# PostgreSQL connection (matches docker-compose.yml locally).
# In production, use the connection string from Render PostgreSQL / Neon / etc.
DATABASE_URL=postgres://rxuser:rxpass@localhost:5942/rxtracker

# API server (Render provides its own PORT at runtime — this is the local fallback)
PORT=4879

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: comma-separated list of allowed frontend origins, e.g.
#   FRONTEND_URL=https://your-app.vercel.app,https://your-app-git-preview.vercel.app
# Leave empty locally — http://localhost:5820 is always allowed.
FRONTEND_URL=

# Seed: first admin account (created by db/seed.js). In production these must
# be set explicitly to real values — the script refuses to run with these
# dev defaults when NODE_ENV=production.
SEED_ADMIN_NAME=Root Admin
SEED_ADMIN_EMAIL=admin@rxtracker.local
SEED_ADMIN_PASSWORD=admin12345
