# Copy to client/.env for local development.
# In Vercel, set this as a Project Environment Variable instead of committing a file.

# Local dev: leave empty. Requests stay relative ("/api/...") and are
# handled by the Vite dev server proxy defined in vite.config.js.
#
# Production: set to the deployed Render backend's origin, no trailing slash.
#   VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
VITE_API_URL=
